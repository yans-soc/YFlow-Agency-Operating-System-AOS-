# =============================================================================
# YANS DIGITAL Platform — .env.example (KEYS ONLY, no real values)
# Real values live in Coolify (encrypted), never in git.
# Docs: docs/platform/08-shared-variables.md · docs/platform/07-application-onboarding.md
# =============================================================================

# --- Shared (attach as Coolify shared/env group to every app) ----------------
APP_ENV=production
TZ=Asia/Jakarta
LOG_LEVEL=info

# Data tier (VPS2 over Tailscale) — host/port shared; names/creds per-app
DATABASE_HOST=
DATABASE_PORT=3306
REDIS_HOST=
REDIS_PORT=6379

# Mail relay (shared endpoint; credentials per-app)
MAIL_HOST=
MAIL_PORT=587

# Drivers (uniform across apps)
QUEUE_CONNECTION=redis
CACHE_STORE=redis
SESSION_DRIVER=redis

# --- App-specific (set INSIDE each app's Coolify resource, NOT shared) --------
APP_NAME=
APP_KEY=            # php artisan key:generate  (unique per app)
APP_URL=            # https://<app>.apps.yansdigital.com

DATABASE_NAME=      # <app>_prod
DATABASE_USERNAME=  # <app>_prod
DATABASE_PASSWORD=  # secret (Coolify only)
REDIS_DB=           # unique logical index per app

MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Add other app-specific keys below (API keys, feature flags, etc.)
